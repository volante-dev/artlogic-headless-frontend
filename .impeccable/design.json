      "description": "Generic MUI contained action; no elevation or ripple. Hover follows the derived primary-dark role.",
      "html": "<button class=\"ds-primary\" type=\"button\">Réessayer</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;min-width:64px;min-height:44px;padding:10px 18px;border:0;border-radius:0;box-shadow:none;background:var(--site-color-accent,#3C554A);color:var(--site-color-onAccent,#FFFFFF);font-family:var(--site-button-fontFamily,\"site_hanken_grotesk\",sans-serif);font-size:var(--site-button-fontSize,clamp(0.875rem, 0.8309859154929577rem + 0.18779342723004694vw, 1rem));font-weight:var(--site-button-fontWeight,500);line-height:var(--site-button-lineHeight,1.5);letter-spacing:var(--site-button-letterSpacing,0em);text-transform:none;cursor:pointer;transition:background-color 250ms cubic-bezier(.4,0,.2,1),box-shadow 250ms cubic-bezier(.4,0,.2,1),border-color 250ms cubic-bezier(.4,0,.2,1),color 250ms cubic-bezier(.4,0,.2,1);}@media(hover:hover){.ds-primary:hover{background:var(--gallery-palette-primary-dark,rgb(42,59,51));}}.ds-primary:focus-visible{outline:3px solid var(--site-color-focus,#21623F);outline-offset:4px;}.ds-primary:active{box-shadow:none;}.ds-primary:disabled{color:var(--site-color-disabledText,#66716C);background:var(--site-color-mutedSurface,#E7EAE8);cursor:not-allowed;}"

      "html": "<div class=\"ds-inverse\"><button class=\"ds-menu\" type=\"button\" aria-expanded=\"false\">Ouvrir le menu</button></div>",
      "css": ".ds-inverse{background:var(--site-color-inverseSurface,#101314);color:var(--site-color-inverseText,#F6F7F6);padding:24px;}.ds-menu{display:inline-flex;align-items:center;justify-content:center;min-width:64px;min-height:44px;padding:10px 18px;border:1px solid currentColor;border-radius:0;background:transparent;color:inherit;box-shadow:none;font-family:var(--site-button-fontFamily,\"site_hanken_grotesk\",sans-serif);font-size:var(--site-button-fontSize,clamp(0.875rem, 0.8309859154929577rem + 0.18779342723004694vw, 1rem));font-weight:var(--site-button-fontWeight,500);line-height:var(--site-button-lineHeight,1.5);letter-spacing:var(--site-button-letterSpacing,0em);text-transform:none;cursor:pointer;transition:background-color 250ms cubic-bezier(.4,0,.2,1),box-shadow 250ms cubic-bezier(.4,0,.2,1),border-color 250ms cubic-bezier(.4,0,.2,1),color 250ms cubic-bezier(.4,0,.2,1);}.ds-menu:hover{background:color-mix(in srgb,currentColor 8%,transparent);border-color:currentColor;}.ds-menu:focus-visible{outline:2px solid currentColor;outline-offset:4px;}.ds-menu:active{box-shadow:none;}"

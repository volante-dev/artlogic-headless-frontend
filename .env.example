# Deployment configuration; never commit real credentials.
# Backend scopes: A=API, W=worker, M=migration. Only inject each process's scopes.

# AWMFBX | optional | server only; development|test|production
NODE_ENV=development

# AWMFBX | required | server only; local|test|production
DEPLOYMENT_ENV=

# AWMFBX | required | server only; real|mock
DATA_MODE=

# AWMFB | required | public identity
SITE_ID=

# FB | required | public identity
SITE_NAME=

# F | optional | public identity
SITE_DESCRIPTION=

# AFB | required | server only
SITE_ORIGIN=

# FB | required | server only
BACKEND_URL=

# FB | optional | server only; integer 1..120000
REQUEST_TIMEOUT_MS=15000
PUBLIC_MEDIA_REQUEST_TIMEOUT_MS=45000

# Site languages; identical across API, worker, frontend and BFF.
SITE_LOCALES_JSON='[ {"code":"fr","label":"Français"}, {"code":"en","label":"English"} ]'
SITE_DEFAULT_LOCALE=fr



# Optional immersive editorial reading
EDITORIAL_IMMERSIVE_RENDER_ENABLED=true


# Public page/API reads: bounded cold-start allowance, milliseconds (1000..120000).
PUBLIC_PAGE_REQUEST_TIMEOUT_MS=45000



# Diffusion directe des médias publics (025), désactivée par défaut.
PUBLIC_MEDIA_DIRECT_ENABLED=false
PUBLIC_MEDIA_DELIVERY_ORIGINS_JSON=[]
PUBLIC_MEDIA_LOAD_TIMEOUT_MS=60000

# BEGIN generated presentation settings
# F | optional
PUBLIC_IMAGE_RESPONSIVE_ENABLED=false

# F | optional | 100..3000
PUBLIC_IMAGE_DESCRIPTOR_TIMEOUT_MS=1500

# AWMFB | optional
FORMS_ENABLED=false

# AWMF | optional
FORMS_CONTACT_CUTOVER=false

# F | optional
EDITORIAL_IMMERSIVE_RENDER_ENABLED=true

# AWMFB | optional
EDITORIAL_ENABLED=false

# AWF | optional
CONTACT_ENABLED=false

# AF | required | SECRET, server only
CONTACT_SERVICE_KEY=

# F | optional
CONTACT_TRUSTED_INGRESS_HEADER=

# F | optional | SECRET, server only
CONTACT_INGRESS_KEY=

# AWMF | optional
SITE_PROFILE=default

# AF | required | SECRET, server only
PREVIEW_SERVICE_KEY=

# F | optional
SITE_ALLOWED_ORIGINS_JSON=[]

# AWFB | required
ADMIN_ORIGIN=
# END generated presentation settings

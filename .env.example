# Deployment configuration; never commit real credentials.
# Backend scopes: A=API, W=worker, M=migration. Only inject each process's scopes.

# AWMFBX | optional | server only; development|test|production
NODE_ENV=development

# AWMFBX | required | server only; local|test|production
DEPLOYMENT_ENV=

# AWMFBX | required | server only; real|mock
DATA_MODE=

# AWMFB | required | public identity
SITE_ID=

# FB | required | public identity
SITE_NAME=

# F | optional | public identity
SITE_DESCRIPTION=

# AFB | required | server only
SITE_ORIGIN=

# FB | required | server only
BACKEND_URL=

# FB | optional | server only; integer 1..120000
REQUEST_TIMEOUT_MS=15000
